# ==========================================
# MAZZI PLATFORM — ENVIRONMENT VARIABLES
# ==========================================

# AI Studio & Runtime
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://localhost:3000"
NODE_ENV="development"
PORT="3000"

# Database & Supabase (PostgreSQL 16 + PostGIS)
DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Authentication & Security
AUTH_SECRET="your-256-bit-secret-here"
JWT_EXPIRATION="7d"

# Payment Gateway (e.g. Asaas, Pagar.me, Stripe)
PAYMENT_GATEWAY_PROVIDER="development" # Options: development, asaas, pagarme, stripe
PAYMENT_GATEWAY_API_KEY=""
PAYMENT_GATEWAY_WEBHOOK_SECRET=""

# Storage (Supabase Storage / S3 / Private Storage)
STORAGE_BUCKET_NAME="mazzi-compliance-private"
STORAGE_REGION="southamerica-east1"

# Platform Business Defaults (Development Settings)
DEFAULT_PLATFORM_FEE_PERCENTAGE="10" # [DECISÃO PENDENTE]
QUOTE_EXPIRATION_MINUTES="10"
SAFETY_PERIOD_HOURS_FOR_PAYOUT="24"
