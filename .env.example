# ============================================================
# MAZZI — VARIÁVEIS EFETIVAMENTE UTILIZADAS
# ============================================================
# Este arquivo é somente uma referência. Não coloque segredos reais aqui.
#
# Destinos:
# - VITE_*: .env.local no desenvolvimento e GitHub no deploy Cloudflare.
# - Edge Functions: Supabase Secrets.
# - Scripts/CI: terminal local ou GitHub Secrets.


# ------------------------------------------------------------
# FRONTEND — .env.local / GitHub
# ------------------------------------------------------------

# Ambiente visual: development exibe avisos de teste; production não exibe
# referências ao gateway ou às credenciais de teste.
VITE_APP_ENV="development"

# Supabase público. Essas duas variáveis são obrigatórias nos três apps.
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Geocodificação de endereços no navegador.
VITE_GEOAPIFY_API_KEY=""

# Checkout ativo: fake ou mercadopago.
# O valor padrão seguro é fake.
VITE_PAYMENT_GATEWAY_PROVIDER="fake"

# Public Key obtida em Mercado Pago > Credenciais (teste ou produção).
# Preencher somente quando VITE_PAYMENT_GATEWAY_PROVIDER="mercadopago".
VITE_MERCADOPAGO_PUBLIC_KEY=""


# ------------------------------------------------------------
# LOGIN RÁPIDO — SOMENTE .env.local EM DESENVOLVIMENTO
# ------------------------------------------------------------

VITE_ENABLE_DEV_QUICK_LOGIN="false"
VITE_DEV_QUICK_LOGIN_STUDENT_PASSWORD=""
VITE_DEV_QUICK_LOGIN_INSTRUCTOR_PASSWORD=""
VITE_DEV_QUICK_LOGIN_SCHOOL_PASSWORD=""
VITE_DEV_QUICK_LOGIN_ADMIN_PASSWORD=""


# ------------------------------------------------------------
# SUPABASE EDGE FUNCTIONS — configurar em Supabase Secrets
# ------------------------------------------------------------
# Não use o prefixo VITE_ e não coloque estes valores no frontend.

# Access Token obtido em Mercado Pago > Credenciais (teste ou produção).
MERCADOPAGO_ACCESS_TOKEN=""

# Valores aceitos: test ou production. O token precisa corresponder ao ambiente.
MERCADOPAGO_ENVIRONMENT="test"

# Chave secreta configurada em Mercado Pago > Webhooks > assinatura secreta.
# Necessária para validar notificações de Pix no Edge Function.
MERCADOPAGO_WEBHOOK_SECRET=""

# Destino do convite enviado para novos usuários administrativos.
MAZZI_ADMIN_INVITE_REDIRECT_URL="https://mazzi-admin-dev.pages.dev"

# SUPABASE_URL, SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY são
# fornecidas automaticamente pelo Supabase às Edge Functions.


# ------------------------------------------------------------
# SCRIPTS LOCAIS DE BANCO — usar somente quando necessário
# ------------------------------------------------------------

DATABASE_URL=""
MAZZI_ALLOW_LIVE_MIGRATION="false"

# Alguns scripts administrativos legados usam estas variáveis sem VITE_.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""


# ------------------------------------------------------------
# DEPLOY CLOUDFLARE — GitHub Secrets
# ------------------------------------------------------------

CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
