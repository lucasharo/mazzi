# ==========================================
# MAZZI PLATFORM — ENVIRONMENT VARIABLES
# ==========================================

# AI Studio & Runtime
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://localhost:3000"
NODE_ENV="development"
PORT="3000"

# Frontend-exposed public Supabase variables (required by Vite/browser runtime).
# Never create VITE_SUPABASE_SERVICE_ROLE_KEY.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Geoapify Address Autocomplete / Forward & Reverse Geocoding (browser key; beta only)
VITE_GEOAPIFY_API_KEY=""

# Authentication & Security
AUTH_SECRET="your-256-bit-secret-here"
JWT_EXPIRATION="7d"

# Payment Gateway
# FASE ATUAL: MVP marketplace validation (fake_payment_gateway).
# Pagamento financeiro real Mercado Pago está desabilitado na fase atual de validação.
# Para permitir a execução de testes/validação em bundle de produção, configure VITE_PAYMENT_MODE="MOCK_VALIDATION".
VITE_PAYMENT_MODE="MOCK_VALIDATION" # Options: MOCK_VALIDATION, REAL_DISABLED
PAYMENT_GATEWAY_PROVIDER="fake" # Options: fake, mercadopago
VITE_PAYMENT_GATEWAY_PROVIDER="fake"
VITE_MERCADOPAGO_PUBLIC_KEY="" # Chave pública de TESTE; nunca use credencial de produção em DEV
PAYMENT_GATEWAY_API_KEY=""
PAYMENT_GATEWAY_WEBHOOK_SECRET=""
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_CLIENT_ID=""
MERCADOPAGO_CLIENT_SECRET=""
MERCADOPAGO_LIVE_HTTP="false"
MERCADOPAGO_ENVIRONMENT="test" # Segredo da Edge Function; qualquer outro valor bloqueia a cobrança

# Storage (Supabase Storage / S3 / Private Storage)
STORAGE_BUCKET_NAME="mazzi-compliance-private"
STORAGE_REGION="southamerica-east1"

# Platform Business Defaults (Development Settings)
DEFAULT_PLATFORM_FEE_PERCENTAGE="10" # [DECISÃO PENDENTE]
QUOTE_EXPIRATION_MINUTES="10"
SAFETY_PERIOD_HOURS_FOR_PAYOUT="24"

# Dev Quick Login (DEV ONLY - Local Environment Only)
VITE_ENABLE_DEV_QUICK_LOGIN="false"
VITE_DEV_QUICK_LOGIN_STUDENT_PASSWORD=""
VITE_DEV_QUICK_LOGIN_INSTRUCTOR_PASSWORD=""
VITE_DEV_QUICK_LOGIN_SCHOOL_PASSWORD=""
VITE_DEV_QUICK_LOGIN_ADMIN_PASSWORD=""

